<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="21.2.9" type="device"><diagram id="flow_q3" name="问题三求解流程"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1080" pageHeight="620" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q3_in" value="&lt;b&gt;输入初值与全向场景&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;起点 (0,0)，频道 c=1；N∈[10,16] 未知&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#7B9FC0;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="300" height="46" as="geometry"/></mxCell><mxCell id="q3_e1" edge="1" parent="1" source="q3_in" target="q3_sc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q3_e2" edge="1" parent="1" source="q3_in" target="q3_mod" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q3_sc" value="&lt;b&gt;同站批量扫频&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;已清频道不再测向&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AAA7A;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="86" width="240" height="50" as="geometry"/></mxCell><mxCell id="q3_mod" value="&lt;b&gt;复用交会与第二点模块&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;楔形交集 + 候选点策略&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AAA7A;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="690" y="86" width="240" height="50" as="geometry"/></mxCell><mxCell id="q3_e3" edge="1" parent="1" source="q3_sc" target="q3_obs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q3_e4" edge="1" parent="1" source="q3_mod" target="q3_obs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q3_obs" value="&lt;b&gt;解析观测三值&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;direction / near / no_signal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#7B9FC0;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="350" y="160" width="300" height="46" as="geometry"/></mxCell><mxCell id="q3_e5" edge="1" parent="1" source="q3_obs" target="q3_d1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q3_d1" value="&lt;b&gt;是否收到方向&lt;br&gt;或进入近场?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F0E8;strokeColor=#B0A080;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="400" y="224" width="200" height="80" as="geometry"/></mxCell><mxCell id="q3_y1" value="&lt;font style=&quot;font-size:10px;color:#7AAA7A;&quot;&gt;&lt;b&gt;是&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="505" y="306" width="28" height="18" as="geometry"/></mxCell><mxCell id="q3_n1" value="&lt;font style=&quot;font-size:10px;color:#B08080;&quot;&gt;&lt;b&gt;否&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="248" width="28" height="18" as="geometry"/></mxCell><mxCell id="q3_e6" edge="1" parent="1" source="q3_d1" target="q3_d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q3_e7" edge="1" parent="1" source="q3_d1" target="q3_ns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q3_ns" value="&lt;b&gt;无信号距离排除&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;确信有源时 d&gt;r_i≥1000 m&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EDED;strokeColor=#B08080;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="690" y="238" width="230" height="52" as="geometry"/></mxCell><mxCell id="q3_e8" edge="1" parent="1" source="q3_d2" target="q3_cl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q3_d2" value="&lt;b&gt;包围半径&lt;br&gt;是否 ≤20 m?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F0E8;strokeColor=#B0A080;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="400" y="328" width="200" height="80" as="geometry"/></mxCell><mxCell id="q3_y2" value="&lt;font style=&quot;font-size:10px;color:#7AAA7A;&quot;&gt;&lt;b&gt;是&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="505" y="410" width="28" height="18" as="geometry"/></mxCell><mxCell id="q3_n2" value="&lt;font style=&quot;font-size:10px;color:#B08080;&quot;&gt;&lt;b&gt;否&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="352" width="28" height="18" as="geometry"/></mxCell><mxCell id="q3_e9" edge="1" parent="1" source="q3_d2" target="q3_2nd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q3_2nd" value="&lt;b&gt;调用第二点并继续交会&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;拉开基线；同点重复不计新样本&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECF5;strokeColor=#9A8AB0;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="690" y="340" width="230" height="52" as="geometry"/></mxCell><mxCell id="q3_cl" value="&lt;b&gt;确定清除并更新 K&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;成功不计切换费；二次清除不加 K&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AAA7A;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="350" y="432" width="300" height="46" as="geometry"/></mxCell><mxCell id="q3_e10" edge="1" parent="1" source="q3_cl" target="q3_d3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q3_d3" value="&lt;b&gt;20 频道是否均已&lt;br&gt;清除或证书判空?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F0E8;strokeColor=#B0A080;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="496" width="220" height="82" as="geometry"/></mxCell><mxCell id="q3_y3" value="&lt;font style=&quot;font-size:10px;color:#7AAA7A;&quot;&gt;&lt;b&gt;是&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="615" y="522" width="28" height="18" as="geometry"/></mxCell><mxCell id="q3_n3" value="&lt;font style=&quot;font-size:10px;color:#B08080;&quot;&gt;&lt;b&gt;否&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="285" y="498" width="28" height="18" as="geometry"/></mxCell><mxCell id="q3_e11" edge="1" parent="1" source="q3_d3" target="q3_out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q3_loop" edge="1" parent="1" source="q3_d3" target="q3_sc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#B08080;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="18" y="537"/><mxPoint x="18" y="111"/></Array></mxGeometry></mxCell><mxCell id="q3_loop2" edge="1" parent="1" source="q3_ns" target="q3_sc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#B08080;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1048" y="264"/><mxPoint x="1048" y="6"/><mxPoint x="18" y="6"/><mxPoint x="18" y="111"/></Array></mxGeometry></mxCell><mxCell id="q3_loop3" edge="1" parent="1" source="q3_2nd" target="q3_mod" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#B08080;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="978" y="366"/><mxPoint x="978" y="111"/></Array></mxGeometry></mxCell><mxCell id="q3_out" value="&lt;b&gt;输出 GREEDY_FAST 在线策略&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;先全清 K=N，再缩短任务时间 T&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF5ED;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="690" y="510" width="250" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
