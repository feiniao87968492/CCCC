<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="21.2.9" type="device"><diagram id="flow_q4" name="问题四求解流程"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1080" pageHeight="630" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q4_in" value="&lt;b&gt;输入定向混合场景&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;继承计时与状态；朝向未知&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#7B9FC0;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="300" height="46" as="geometry"/></mxCell><mxCell id="q4_e1" edge="1" parent="1" source="q4_in" target="q4_hex" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q4_e2" edge="1" parent="1" source="q4_in" target="q4_loc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q4_hex" value="&lt;b&gt;HEX37 覆盖骨架&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;三角格点间距 800 m / 37 点&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AAA7A;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="86" width="240" height="50" as="geometry"/></mxCell><mxCell id="q4_loc" value="&lt;b&gt;累计全部测向楔形&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;外包 Ω 与 1500 m 接收半径&lt;/font&gt;" style="rounded=