<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="21.2.9" type="device"><diagram id="flow_q2" name="问题二求解流程"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1020" pageHeight="490" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q2_in" value="&lt;b&gt;输入第一检测点与示向度&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;单全向源；真位置与 r_i 未知&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#7B9FC0;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="20" width="260" height="46" as="geometry"/></mxCell><mxCell id="q2_e1" edge="1" parent="1" source="q2_in" target="q2_sec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q2_e2" edge="1" parent="1" source="q2_in" target="q2_om" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q2_sec" value="&lt;b&gt;前向 180° 可行扇&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;仅用已观测楔形，不用未知真值&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AAA7A;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="88" width="250" height="50" as="geometry"/></mxCell><mxCell id="q2_om" value="&lt;b&gt;叠加圆域与半径区间&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;Ω 半径 1800 m；r_i∈[1000,1500]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AAA7A;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="670" y="88" width="250" height="50" as="geometry"/></mxCell><mxCell id="q2_e3" edge="1" parent="1" source="q2_sec" target="q2_cand" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q2_e4" edge="1" parent="1" source="q2_om" target="q2_cand" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q2_cand" value="&lt;b&gt;构造第二点候选集&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;保证可能收到信号；禁止用未知 G 排点&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#7B9FC0;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="163" width="340" height="48" as="geometry"/></mxCell><mxCell id="q2_e5" edge="1" parent="1" source="q2_cand" target="q2_j" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q2_j" value="&lt;b&gt;计算候选指标 J*&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;最坏点误差 / 交会直径充分条件&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECF5;strokeColor=#9A8AB0;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="350" y="228" width="300" height="48" as="geometry"/></mxCell><mxCell id="q2_e6" edge="1" parent="1" source="q2_j" target="q2_dia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q2_dia" value="&lt;b&gt;diam(R) 能否进入&lt;br&gt;可清除尺度?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F0E8;strokeColor=#B0A080;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="400" y="293" width="200" height="82" as="geometry"/></mxCell><mxCell id="q2_yes" value="&lt;font style=&quot;font-size:10px;color:#7AAA7A;&quot;&gt;&lt;b&gt;是&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="505" y="376" width="28" height="18" as="geometry"/></mxCell><mxCell id="q2_no" value="&lt;font style=&quot;font-size:10px;color:#B08080;&quot;&gt;&lt;b&gt;否&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="318" width="28" height="18" as="geometry"/></mxCell><mxCell id="q2_e7" edge="1" parent="1" source="q2_dia" target="q2_out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q2_e8" edge="1" parent="1" source="q2_dia" target="q2_adj" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q2_adj" value="&lt;b&gt;调整第二点几何&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;拉开基线 / 避开共线&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EDED;strokeColor=#B08080;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="690" y="308" width="220" height="52" as="geometry"/></mxCell><mxCell id="q2_loop" edge="1" parent="1" source="q2_adj" target="q2_cand" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#B08080;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="334"/><mxPoint x="980" y="187"/></Array></mxGeometry></mxCell><mxCell id="q2_out" value="&lt;b&gt;输出第二点策略与候选区&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;供问题3发现源后直接调用&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF5ED;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="330" y="408" width="340" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
