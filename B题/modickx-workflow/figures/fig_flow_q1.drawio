<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="21.2.9" type="device"><diagram id="flow_q1" name="问题一求解流程"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1020" pageHeight="560" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q1_in" value="&lt;b&gt;输入检测点与示向度&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;前向闭楔形 / 误差闭区间 ±1°&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#7B9FC0;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="20" width="260" height="46" as="geometry"/></mxCell><mxCell id="q1_e1" edge="1" parent="1" source="q1_in" target="q1_w" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q1_e2" edge="1" parent="1" source="q1_in" target="q1_d" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q1_w" value="&lt;b&gt;构造前向闭楔形&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;示向度两侧各 1° / 射线半平面&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AAA7A;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="88" width="250" height="50" as="geometry"/></mxCell><mxCell id="q1_d" value="&lt;b&gt;枚举退化情形&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;空集 / 点 / 线段 / 无界条带&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AAA7A;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="670" y="88" width="250" height="50" as="geometry"/></mxCell><mxCell id="q1_e3" edge="1" parent="1" source="q1_w" target="q1_r" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q1_e4" edge="1" parent="1" source="q1_d" target="q1_r" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q1_r" value="&lt;b&gt;求楔形交集 R&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;多点交为多边形；两点为四边形&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#7B9FC0;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="350" y="163" width="300" height="48" as="geometry"/></mxCell><mxCell id="q1_e5" edge="1" parent="1" source="q1_r" target="q1_dia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q1_dia" value="&lt;b&gt;R 是否有界&lt;br&gt;且非空?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F0E8;strokeColor=#B0A080;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="410" y="228" width="180" height="78" as="geometry"/></mxCell><mxCell id="q1_yes" value="&lt;font style=&quot;font-size:10px;color:#7AAA7A;&quot;&gt;&lt;b&gt;是&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="308" width="28" height="18" as="geometry"/></mxCell><mxCell id="q1_no" value="&lt;font style=&quot;font-size:10px;color:#B08080;&quot;&gt;&lt;b&gt;否&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="252" width="28" height="18" as="geometry"/></mxCell><mxCell id="q1_e6" edge="1" parent="1" source="q1_dia" target="q1_diam" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q1_e7" edge="1" parent="1" source="q1_dia" target="q1_deg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q1_deg" value="&lt;b&gt;退化输出&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;报告空 / 无界；不强制多边形&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EDED;strokeColor=#B08080;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="241" width="230" height="52" as="geometry"/></mxCell><mxCell id="q1_loop" edge="1" parent="1" source="q1_deg" target="q1_w" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#B08080;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="267"/><mxPoint x="980" y="6"/><mxPoint x="18" y="6"/><mxPoint x="18" y="113"/></Array></mxGeometry></mxCell><mxCell id="q1_diam" value="&lt;b&gt;计算几何直径 diam(R)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;最大点对距离，非覆盖圆直径&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECF5;strokeColor=#9A8AB0;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="350" y="333" width="300" height="48" as="geometry"/></mxCell><mxCell id="q1_e8" edge="1" parent="1" source="q1_diam" target="q1_cov" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q1_e9" edge="1" parent="1" source="q1_diam" target="q1_jung" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q1_cov" value="&lt;b&gt;直径圆覆盖性判定&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;一般不能覆盖 R&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AAA7A;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="408" width="250" height="50" as="geometry"/></mxCell><mxCell id="q1_jung" value="&lt;b&gt;Jung 最小覆盖圆对照&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;等边三角形 r = 边长/√3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AAA7A;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="670" y="408" width="250" height="50" as="geometry"/></mxCell><mxCell id="q1_e10" edge="1" parent="1" source="q1_cov" target="q1_out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q1_e11" edge="1" parent="1" source="q1_jung" target="q1_out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="q1_out" value="&lt;b&gt;输出交会算法与覆盖性结论&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#555555;&quot;&gt;后续清除须核验豪斯多夫半径 ≤20 m&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF5ED;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="320" y="478" width="360" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
